void mMsg_Set_LineFontColor(MessageWindow* window, s32 lineNo, char r, char g, char b, char a) {
    if (lineNo >= 0 && lineNo < MESSAGE_LINE_NUMBER) {
        Color_RGBA8* color = &window->fontColor[lineNo];

        color->r = r;
        color->g = g;
        color->b = b;
        color->a = a;
    }
}

void mMsg_init_FontColor(MessageWindow* window) {
    s32 i;

    for (i = 0; i < MESSAGE_LINE_NUMBER; i++) {
        mMsg_Set_LineFontColor(window, i, 50, 60, 50, 255);
    }
}

void mMsg_init_NowDisplayLIne(MessageWindow* window) {
    window->nowDisplayLine = FALSE;
}

void mMsg_Clear_CursolIndex(MessageWindow* window) {
    window->startTextCursolIdx = window->endTextCursolIdx;
    mMsg_init_FontColor(window);
    mMsg_init_NowDisplayLIne(window);
}

void mMsg_SetTimer(MessageWindow* window, f32 timer) {
    window->cursolTimer = timer;
}
void mMsg_Get_BodyParam(s32 idx, u32* vramp, size_t* size) {
    s32 sized;
    u32 offsetPtrs[5];

    if (idx >= 0 && idx < MESSAGE_IDX_MAX) {
        u32 vrom;
        if (idx & 1) {
#ifndef AF_CN
            DmaMgr_RequestSyncDebug(offsetPtrs, (u32)&D_CF9000[idx - 1], 8, "../m_msg_main.c", 855);
#else
            DmaMgr_RequestSyncDebug(offsetPtrs, (u32)&D_CF9000[idx - 1], 8, "../m_msg_main.c", 867);
#endif
            vrom = offsetPtrs[0];
            sized = offsetPtrs[1] - vrom;
        } else if (idx == 0) {
#ifndef AF_CN
            DmaMgr_RequestSyncDebug(offsetPtrs, (u32)&D_CF9000, 8, "../m_msg_main.c", 862);
#else
            DmaMgr_RequestSyncDebug(offsetPtrs, (u32)&D_CF9000, 8, "../m_msg_main.c", 874);
#endif
            vrom = 0;
            sized = offsetPtrs[0] - vrom;
        } else {
#ifndef AF_CN
            DmaMgr_RequestSyncDebug(offsetPtrs, (u32)&D_CF9000[idx - 2], 16, "../m_msg_main.c", 868);
#else
            DmaMgr_RequestSyncDebug(offsetPtrs, (u32)&D_CF9000[idx - 2], 16, "../m_msg_main.c", 880);
#endif

            vrom = offsetPtrs[1];
            sized = offsetPtrs[2] - vrom;
        }
        if (sized <= MESSAGE_TEXT_BUFFER_LEN) {
            *vramp = (u32)vrom + (u32)&D_BD4000;
            *size = sized;
#ifndef AF_CN
        } else {
            *vramp = NULL;
            *size = 0;
        }
#else
        } else {
            *vramp = (u32)vrom + (u32)&D_BD4000;
            *size = MESSAGE_TEXT_BUFFER_LEN;
        }
#endif
    } else {
        *vramp = NULL;
        *size = 0;
    }
}

s32 mMsg_Count_MsgData(char* data) {
    s32 i = 0;

    while (i < MESSAGE_TEXT_BUFFER_LEN) {
        if (mMsg_Check_LastCode_forData(data, i) || mMsg_Check_ContinueCode_forData(data, i) ||
            mMsg_Check_MsgTimeEndCode_forData(data, i)) {
            i += mFont_CodeSize_idx_get(data, i);
            break;
        }

        i += mFont_CodeSize_idx_get(data, i);
    }

    return i;
}


// todo
s32 mMsg_LoadMsgData(MessageData* data, s32 idx, s32 cut) {
    if (data != NULL) {
        u32 addr;
        u32 size;

        //mMsg_Get_MsgDataAddressAndSize(idx, &addr, &size);
        mMsg_Get_BodyParam(idx, &addr, &size);

        if (addr != 0 && size != 0) {
            u32 alignedAddr = addr & ~7;
            s32 ofs = addr - alignedAddr;
            char* dataBuffer = data->dataBuffer;

#ifndef AF_CN

            DmaMgr_RequestSyncDebug(data->dataBuffer, alignedAddr, ALIGN8((ofs) + size), "../m_msg_main.c", 962);
#else
            DmaMgr_RequestSyncDebug(data->dataBuffer, alignedAddr, ALIGN8((ofs) + size), "../m_msg_main.c", 974);

#endif

            {
                char* dstPtr;
                char* srcPtr;
                s32 len;
                s32 i;
                len = size;
                dstPtr = data->dataBuffer;
                srcPtr = data->dataBuffer + ofs;
                i = 0;

                for (; i < len; i++) {
                    *dstPtr++ = *srcPtr++;
                }
            }

            data->msgNo = idx;
            data->dataLoaded = TRUE;
            data->msgLen = mMsg_Count_MsgData(data->dataBuffer);
            data->cut = cut;

            return TRUE;
        }
    }
    data->dataLoaded = FALSE;

    return FALSE;
}

s32 mMsg_ChangeMsgData(MessageWindow* window, s32 idx) {
    if (idx >= 0 && idx < MESSAGE_IDX_MAX && mMsg_LoadMsgData(window->messageData, idx, FALSE)) {
        window->endTextCursolIdx = 0;
        mMsg_Clear_CursolIndex(window);
        mMsg_SetTimer(window, 10.0f);
        return TRUE;
    }

    return FALSE;
}

