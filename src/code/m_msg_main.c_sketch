    return 2;
}

s32 mMsg_Main_Cursol_SetNextMessage_ControlCursol(MessageWindow* window, s32* idxPtr, s32 selectNo) {
    u16 msgNo;
    u8* data = window->messageData->dataBuffer;
    s32 choiceNum = mChoice_Get_ChoseNum(mChoice_Get_base_window_p());

    msgNo = data[(*idxPtr) + 2] << 8;
    msgNo = ((data[(*idxPtr) + 3]) & 0xFF) | msgNo;

    if (selectNo == 0xFF || selectNo == choiceNum) {
        if (msgNo != 0xFFFF) {
            mMsg_Set_continue_msg_num(window, msgNo);
        } else {
            mMsg_Set_CancelNormalContinue(window);
        }
    }

    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);
    return 0;
}

