    if (code[0] == MESSAGE_CHAR_CONTROL_CODE && code[1] == 87 && code[2] < 8 && code[3] < 3) {
        *bgmType = code[2];
        *stopType = code[3];
    } else {
        *bgmType = 8;
        *stopType = 3;
    }
}

void mMsg_Get_bgm_delete(MessageWindow* window, s32 idx, s32* bgmType, s32* stopTypee) {
    mMsg_Get_bgm_make_forData(window->messageData->dataBuffer, idx, bgmType, stopTypee);
}

