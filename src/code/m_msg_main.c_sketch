MessageWindow* mMsg_Get_base_window_p(void) {
    return &mMsg_window;
}

s32 mMsg_Check_request_priority(MessageWindow* window, s32 priority) {
    s32 windowPrio = window->requestedPriority;

    return windowPrio < priority;
}

s32 mMsg_Change_request_main_index(MessageWindow* window, s32 mainIndex, s32 priority) {
    if (mMsg_Check_request_priority(window, priority)) {
        window->requestedMainIndex = mainIndex;
        window->requestedPriority = priority;
        return TRUE;
    } else {
        return FALSE;
    }
}

s32 mMsg_Check_main_index(MessageWindow* window, s32 mainIndex) {
    return window->mainIndex == mainIndex;
}

s32 mMsg_Check_main_wait(MessageWindow* window) {
    return mMsg_Check_main_index(window, MESSAGE_MAIN_INDEX_WAIT);
}

int mMsg_Check_not_series_main_wait(MessageWindow* window) {
    return !(mMsg_Check_main_index(window, MESSAGE_MAIN_INDEX_WAIT) ||
             mMsg_Check_main_index(window, MESSAGE_MAIN_INDEX_APPEAR_WAIT) ||
             mMsg_Check_main_index(window, MESSAGE_MAIN_INDEX_DISAPPEAR_WAIT));
}

s32 mMsg_Check_main_hide(MessageWindow* window) {
    return mMsg_Check_main_index(window, MESSAGE_MAIN_INDEX_HIDE);
}

void mMsg_Set_client_actor_p(MessageWindow* window, Actor* clientActor, s32 showName) {
    if (clientActor != NULL) {
        f32 width;
        f32 offsetX;
        s32 pad;
        char name[ANIMAL_NAME_LEN];
        s32 len;

        window->clientActor = clientActor;
        window->showActorName = showName;

        mNpc_GetNpcWorldName(name, (Npc*)clientActor);
        len = mMsg_Get_Length_String(name, ANIMAL_NAME_LEN);
        width = mFont_GetStringWidth(name, len, FALSE);
        offsetX = ((12.0f * (f32)ANIMAL_NAME_LEN) - width) * 0.5f;

        window->nameplateX = 61.0f + offsetX;
        window->nameplateY = 64.0f;
        window->clientNameLen = len;
    } else {
        window->clientActor = NULL;
        window->showActorName = FALSE;
    }
}

s32 mMsg_request_main_forceoff() {
    return mMsg_Change_request_main_index(mMsg_Get_base_window_p(), MESSAGE_MAIN_INDEX_HIDE, 9);
}

s32 mMsg_request_main_appear(MessageWindow* window, Actor* clientActor, s32 showName, Color_RGBA8* windowColor,
                             s32 msgNo, s32 prio) {
    if (mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_APPEAR, prio)) {
        MessageRequestAppearData* data = &window->requestData.appearData;

        data->speakerActor = clientActor;
        data->nameShown = showName;
        data->windowColor = *windowColor;
        data->msgNo = msgNo;
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_request_main_disappear_wait(MessageWindow* window, s32 lastIndex, s32 prio) {
    if (mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_DISAPPEAR_WAIT, prio)) {
        MessageRequestDisappearWaitData* data = &window->requestData.disappearWaitData;

        data->lastMainIndex = lastIndex;
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_request_main_disappear_wait_sub(MessageWindow* window, s32 lastIndex) {
    if (mChoice_check_main_index(mChoice_Get_base_window_p()) == MESSAGE_MAIN_INDEX_HIDE) {
        return mMsg_request_main_disappear_wait(window, lastIndex, 5);
    }

    return FALSE;
}

s32 mMsg_request_main_disappear_wait_type1(MessageWindow* window) {
    return mMsg_request_main_disappear_wait_sub(window, window->mainIndex);
}

s32 mMsg_request_main_disappear_wait_type2(MessageWindow* window) {
    return mMsg_request_main_disappear_wait_sub(window, MESSAGE_MAIN_INDEX_NORMAL);
}

s32 mMsg_request_main_wait(MessageWindow* window, s32 lastIndex, s32 prio) {
    if (mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_WAIT, prio)) {
        MessageRequestWaitData* data = &window->requestData.waitData;

        data->lastMainIndex = lastIndex;
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_request_main_appear_wait(MessageWindow* window, s32 lastIndex, s32 setupFlag, s32 prio) {
    if (mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_APPEAR_WAIT, prio)) {
        MessageRequestAppearWaitData* data = &window->requestData.appearWaitData;

        data->lastMainIndex = lastIndex;
        data->setupFlag = setupFlag;
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_request_main_appear_wait_type2(MessageWindow* window, s32 flag) {
    s32 index = window->mainIndex;

    if (index == MESSAGE_MAIN_INDEX_WAIT) {
        MessageMainWaitData* data = &window->mainData.waitData;
        s32 lastIndex = data->lastMainIndex;
        s32 setupFlag = flag ? TRUE : FALSE;

        return mMsg_request_main_appear_wait(window, lastIndex, setupFlag, 5);
    }

    return FALSE;
}

s32 mMsg_request_main_appear_wait_type1(MessageWindow* window) {
    return mMsg_request_main_appear_wait_type2(window, TRUE);
}

s32 mMsg_request_main_normal(MessageWindow* window, s32 waitFlag, s32 prio) {
    if (mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_NORMAL, prio)) {
        MessageRequestNormalData* data = &window->requestData.normalData;

        data->waitFlag = waitFlag;
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_request_main_cursol(MessageWindow* window, s32 waitFlag, s32 prio) {
    if (mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_CURSOL, prio)) {
        MessageRequestCursolData* data = &window->requestData.cursolData;

        data->waitFlag = waitFlag;
        return TRUE;
    }

    return FALSE;
}

void mMsg_Set_free_str(MessageWindow* window, s32 freeStrNo, char* str, s32 len) {
    if (freeStrNo >= MESSAGE_FREE_STR0 && freeStrNo < MESSAGE_FREE_STR_MAX && str != NULL) {
        s32 i;
        char* freeStr = window->freeStr[freeStrNo];

        if (len > MESSAGE_FREE_STR_LEN) {
            len = MESSAGE_FREE_STR_LEN;
        }

        for (i = 0; i < MESSAGE_FREE_STR_LEN; i++) {
            if (i < len) {
                freeStr[i] = str[i];
            } else {
                freeStr[i] = ' ';
            }
        }
    }

    if (freeStrNo == MESSAGE_FREE_STR1) {
        window->freeStrColorIdx[0] = 0;
    } else if (freeStrNo == MESSAGE_FREE_STR2) {
        window->freeStrColorIdx[1] = 0;
    } else if (freeStrNo == MESSAGE_FREE_STR5) {
        window->freeStrColorIdx[2] = 0;
    }
}

void mMsg_Set_free_str_cl(MessageWindow* window, s32 freeStrNo, char* str, s32 len, s32 colorIdx) {
    mMsg_Set_free_str(window, freeStrNo, str, len);

    if (colorIdx != 0) {
        if (freeStrNo == MESSAGE_FREE_STR1) {
            window->freeStrColorIdx[0] = colorIdx;
        } else if (freeStrNo == MESSAGE_FREE_STR2) {
            window->freeStrColorIdx[1] = colorIdx;
        } else if (freeStrNo == MESSAGE_FREE_STR5) {
            window->freeStrColorIdx[2] = colorIdx;
        }
    }
}

void mMsg_Set_item_str(MessageWindow* window, s32 itemStrNo, char* str, s32 len) {
    if (itemStrNo >= MESSAGE_ITEM_STR0 && itemStrNo < MESSAGE_ITEM_STR_MAX && str != NULL) {
        s32 i;
        char* freeStr = window->itemStr[itemStrNo];

        if (len > MESSAGE_FREE_STR_LEN) {
            len = MESSAGE_FREE_STR_LEN;
        }

        for (i = 0; i < MESSAGE_FREE_STR_LEN; i++) {
            if (i < len) {
                freeStr[i] = str[i];
            } else {
                freeStr[i] = ' ';
            }
        }
    }
}

void mMsg_Get_free_str(MessageWindow* window, s32 freeStrNo, char* str) {
    if (freeStrNo >= MESSAGE_FREE_STR0 && freeStrNo < MESSAGE_FREE_STR_MAX && str != NULL) {
        s32 i;
        char* freeStr = window->freeStr[freeStrNo];

        for (i = 0; i < MESSAGE_FREE_STR_LEN; i++) {
            str[i] = freeStr[i];
        }
    }
}

void mMsg_Get_item_str(MessageWindow* window, s32 itemStrNo, char* str) {
    if (itemStrNo >= MESSAGE_ITEM_STR0 && itemStrNo < MESSAGE_ITEM_STR_MAX && str != NULL) {
        s32 i;
        char* itemStr = window->itemStr[itemStrNo];

        for (i = 0; i < ITEM_NAME_LEN; i++) {
            str[i] = itemStr[i];
        }
    }
}
// todo cn
void mMsg_Set_mail_str(MessageWindow* window, s32 mailStrNo, char* str, s32 len) {
    if (mailStrNo >= MESSAGE_MAIL_STR0 && mailStrNo < MESSAGE_MAIL_STR_MAX && str != NULL) {
        s32 src;
        s32 dst;
        char* dstPtr;
        char* srcPtr;
        s32 rows;
        s32 width;

        if (len > MESSAGE_MAIL_STR_LEN) {
            len = MESSAGE_MAIL_STR_LEN;
        }

        dst = 0;
        dstPtr = window->mailStr[mailStrNo];
        srcPtr = str;
        rows = 0;
        width = 0;

        for (src = 0; src < len; src++) {
            char c = *srcPtr++;

            if (c == MESSAGE_CHAR_NEW_LINE) {
                rows++;
                *dstPtr++ = c;
                dst++;
                width = 0;

                if (dst >= MESSAGE_MAIL_STR_LEN || rows > 4) {
                    break;
                }
            } else {
                *dstPtr++ = c;
                dst++;
                width++;

                if (dst >= MESSAGE_MAIL_STR_LEN) {
                    break;
                } else if (width > 15) {
                    rows++;
                    *dstPtr++ = MESSAGE_CHAR_NEW_LINE;
                    dst++;
                    width = 0;
                    if (dst >= MESSAGE_MAIL_STR_LEN || rows > 4) {
                        break;
                    }
                }
            }
        }
        for (dst; dst < MESSAGE_MAIL_STR_LEN; dst++) {
            *dstPtr++ = ' ';
        }
    }
}

