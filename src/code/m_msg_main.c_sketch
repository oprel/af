s32 mMsg_Main_Cursol_SetSelectString_ControlCursol(MessageWindow* window, s32* idxPtr, s32 selectCount) {
    char* data = window->messageData->dataBuffer;
    s32 idTable[Choice_CHOICE_MAX];
    s32 i;
    u16 id;
    char* str0;
    char* str1;
    char* str2;
    char* str3;

    if ((idxPtr && idxPtr) && idxPtr) {}
    id = data[(*idxPtr) + 2] << 8;
    id = id | data[(*idxPtr) + 3] & 0xFF;
    idTable[0] = id;

    id = data[(*idxPtr) + 4] << 8;
    id = id | data[(*idxPtr) + 5] & 0xFF;
    idTable[1] = id;

    if (selectCount > 2) {
        id = data[(*idxPtr) + 6] << 8;
        id = id | data[(*idxPtr) + 7] & 0xFF;
        idTable[2] = id;
    }

    if (selectCount > 3) {
        id = data[*idxPtr + 8] << 8;
        id = id | data[(*idxPtr) + 9] & 0xFF;
        idTable[3] = id;
    }

    if (selectCount >= 2 && selectCount <= Choice_CHOICE_MAX) {
        static u8 str[Choice_CHOICE_MAX][Choice_CHOICE_STRING_LEN];
        Actor* actor = window->clientActor;

        for (i = 0; i < selectCount; i++) {
            mChoice_Load_ChoseStringFromRom(mChoice_Get_base_window_p(), str[i], idTable[i], actor);
        }

        str0 = str[0];
        str1 = str[1];
        str2 = selectCount > 2 ? str[2] : NULL;
        str3 = selectCount > 3 ? str[3] : NULL;

        mChoice_Set_choice_data(mChoice_Get_base_window_p(), str0, Choice_CHOICE_STRING_LEN, str1,
                                Choice_CHOICE_STRING_LEN, str2, Choice_CHOICE_STRING_LEN, str3,
                                Choice_CHOICE_STRING_LEN);
    }

    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);
    return 0;
}

