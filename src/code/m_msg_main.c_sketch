s32 mMsg_Get_Length_String(char* str, s32 len) {
    s32 i;

    for (i = len - 1; i >= 0; i--) {
        if (str[i] != ' ') {
            break;
        }
    }

    return i + 1;
}

s32 mMsg_Check_MainNormalContinue(MessageWindow* window) {
    if (window->mainIndex == MESSAGE_MAIN_INDEX_NORMAL) {
        if (mMsg_Check_NextIndex_ContinueCode(window)) {
            return TRUE;
        }
    }

    return FALSE;
}

s32 mMsg_Check_MainNormal(MessageWindow* window) {
    if (window->mainIndex == MESSAGE_MAIN_INDEX_NORMAL) {
        return TRUE;
    }
    return FALSE;
}

s32 mMsg_Check_MainHide(MessageWindow* window) {
    if (window->mainIndex == MESSAGE_MAIN_INDEX_HIDE) {
        return TRUE;
    }
    return FALSE;
}

int mMsg_Check_MainDisappear(MessageWindow* window) {
    return window->mainIndex == MESSAGE_MAIN_INDEX_DISAPPEAR;
}

void mMsg_Set_CancelNormalContinue(MessageWindow* window) {
    window->continueCancelFlag = TRUE;
}

void mMsg_Unset_CancelNormalContinue(MessageWindow* window) {
    window->continueCancelFlag = FALSE;
}

void mMsg_Set_ForceNext(MessageWindow* window) {
    window->forceNext = TRUE;
}

void mMsg_Unset_ForceNext(MessageWindow* window) {
    window->forceNext = FALSE;
}

s32 mMsg_Get_LockContinue(MessageWindow* window) {
    return window->lockContinue;
}

void mMsg_Set_LockContinue(MessageWindow* window) {
    window->lockContinue = TRUE;
}

void mMsg_Unset_LockContinue(MessageWindow* window) {
    window->lockContinue = FALSE;
}

void mMsg_Set_idling_req(MessageWindow* window) {
    window->statusFlags |= 0x40;
}

s32 mMsg_Check_idling_now(MessageWindow* window) {
    return (window->statusFlags & 0x80) != FALSE;
}

s32 mMsg_MoveDataCut(char* data, s32 dstIdx, s32 srcIdx, s32 len, s32 spaceFlag) {
    s32 newLen = len;

    if (dstIdx < srcIdx) {
        while (srcIdx < len) {
            data[dstIdx] = data[srcIdx];
            dstIdx++;
            srcIdx++;
        }

        newLen -= srcIdx - dstIdx;

        if (spaceFlag) {
            while (dstIdx < len) {
                data[dstIdx] = ' ';
                dstIdx++;
            }
        }
    } else if (dstIdx > srcIdx) {
        s32 moveSize = len - srcIdx;
        s32 offs = dstIdx - srcIdx;

        newLen += offs;

        if (newLen <= MESSAGE_TEXT_BUFFER_LEN) {
            s32 i;
            char* dstPtr = data + newLen - 1;
            char* srcPtr = data + len - 1;

            for (i = 0; i < moveSize; i++) {
                *dstPtr-- = *srcPtr--;
            }
        }
    }

    return newLen;
}

void mMsg_CopyString(char* dst, char* src, s32 len) {
    s32 i;

    for (i = 0; i < len; i++) {
        *dst++ = *src++;
    }
}

s32 mMsg_Set_PlayerNameColor(char* data, s32* startIdx, s32 len) {
    static char add_string[] = { MESSAGE_CHAR_CONTROL_CODE, 0x50, 75, 95, 155, 0 };
    char* name = common_data.privateInfo->playerId.playerName;
    s32 hyphenCount;
#ifndef AF_CN
    s32 nameLen = mMsg_Get_Length_String(name, PLAYER_NAME_LEN);
#else
    s32 nameLen = func_800A5490(name, PLAYER_NAME_LEN, 32);
#endif
    s32 commandLen;
    s32 newLen;
    s32 initialStartIdx;

    initialStartIdx = *startIdx;
    commandLen = mFont_CodeSize_idx_get(data, *startIdx);

    if (nameLen > 0) {
#ifndef AF_CN
        hyphenCount = mMsg_Count_SameCode(data, (*startIdx) + commandLen, len, '\x90');

        add_string[5] = nameLen + hyphenCount;
#else
        add_string[5] = nameLen;

#endif
        newLen = mMsg_MoveDataCut(data, initialStartIdx + sizeof(add_string), initialStartIdx, len, FALSE);
        mMsg_CopyString(data + initialStartIdx, add_string, sizeof(add_string));

        *startIdx += sizeof(add_string);
    } else {
        newLen = len;
    }

    return newLen;
}

s32 mMsg_CopyPlayerName(char* data, s32 startIdx, s32 len) {
    s32 commandLen = mFont_CodeSize_idx_get(data, startIdx);
    char* name = common_data.privateInfo->playerId.playerName;
    s32 nameLen = mMsg_Get_Length_String(name, PLAYER_NAME_LEN);
    s32 newLen = mMsg_MoveDataCut(data, startIdx + nameLen, startIdx + commandLen, len, FALSE);

    mMsg_CopyString(&data[startIdx], name, nameLen);

    return newLen;
}

s32 mMsg_CopyTalkName(Actor* actor, char* data, s32 startIdx, s32 len) {
    s32 commandLen = mFont_CodeSize_idx_get(data, startIdx);
    char name[ANIMAL_NAME_LEN];
    s32 nameLen;
    s32 newLen;

    if (actor != NULL) {
        mNpc_GetNpcWorldName(name, (Npc*)actor);
        nameLen = mMsg_Get_Length_String(name, sizeof(name));
    } else {
        nameLen = 0;
    }

    newLen = mMsg_MoveDataCut(data, startIdx + nameLen, startIdx + commandLen, len, FALSE);
    mMsg_CopyString(&data[startIdx], name, nameLen);

    return newLen;
}

s32 mMsg_CopyTail(Actor* actor, char* data, s32 startIdx, s32 len) {
    s32 commandLen = mFont_CodeSize_idx_get(data, startIdx);
    char* tail = actor != NULL ? mNpc_GetWordEnding(actor) : NULL;
    s32 tailLen = actor != NULL ? mMsg_Get_Length_String(tail, ANIMAL_CATCHPHRASE_LEN) : 0;
    s32 newLen;

    newLen = mMsg_MoveDataCut(data, startIdx + tailLen, startIdx + commandLen, len, FALSE);
    mMsg_CopyString(&data[startIdx], tail, tailLen);

    return newLen;
}

