s32 mMsg_Main_Cursol_SetNextMessageRamdomCommon_ControlCursol(MessageWindow* window, s32* idxPtr, s32 max) {
    u16 msgTable[4];
    u8* data = window->messageData->dataBuffer;
    s32 selected = get_random_timer(0, max);
    s32 i;

    for (i = 0; i < max; i++) {
        msgTable[i] = data[*idxPtr + 2 + i * 2] << 8;
        msgTable[i] = msgTable[i] | (data[*idxPtr + 3 + i * 2] & 0xFF);
    }

    if (selected < 0 || selected >= max) {
        selected = 0;
    }

    mMsg_Set_continue_msg_num(window, msgTable[selected]);
    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);
    return 0;
}

