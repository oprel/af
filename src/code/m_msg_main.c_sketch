s32 mMsg_Set_SizeCode(MessageWindow* window, s32 idx) {
    return mFont_CodeSize_idx_get(window->messageData->dataBuffer, idx);
}

s32 mMsg_Count_SameCode(char* data, s32 start, s32 length, char code) {
    s32 res = 0;
    s32 i = start;
    char* nowPtr;
    char nowCode;

    while (i < length) {
        nowPtr = &data[i];
        nowCode = *nowPtr;

        if (nowCode == MESSAGE_CHAR_CONTROL_CODE) {
            i += mFont_CodeSize_get(nowPtr);
        } else if (nowCode == code) {
            res++;
            i++;
        } else {
            break;
        }
    }

    return res;
}

s32 mMsg_Check_LastCode_forData(char* data, s32 idx) {
    char code = data[idx];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        code = data[idx + 1];

        if (code == 0) {
            return TRUE;
        }
    }

    return FALSE;
}

s32 mMsg_Check_LastCode(MessageWindow* window, s32 idx) {
    return mMsg_Check_LastCode_forData(window->messageData->dataBuffer, idx);
}

s32 mMsg_Check_ContinueCode_forData(char* data, s32 idx) {
    char code = data[idx];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        code = data[idx + 1];

        if (code == 1) {
            return TRUE;
        }
    }

    return FALSE;
}

s32 mMsg_Check_ContinueCode(MessageWindow* window, s32 idx) {
    return mMsg_Check_LastCode_forData(window->messageData->dataBuffer, idx);
}

s32 mMsg_Check_NextIndex_ContinueCode(MessageWindow* window) {
    if (mMsg_Check_ContinueCode(window, window->endTextCursolIdx)) {
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_Check_NextIndex_LastCode(MessageWindow* window) {
    if (mMsg_Check_LastCode(window, window->endTextCursolIdx)) {
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_Check_NextIndex_SetSelectWindowCode(MessageWindow* window) {
    char* data = window->messageData->dataBuffer;
    s32 idx = window->endTextCursolIdx;
    char code = data[idx];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        code = data[idx + 1];

        if (code == 13) {
            return TRUE;
        }
    }

    return FALSE;
}

f32 mMsg_Get_CursolSetTimeCode_forData(char* data, s32 idx) {
    char code = data[idx];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        code = data[idx + 1];

        if (code == 3) {
            code = data[idx + 2];

            return (f32)(s32)code;
        }
    }

    return 0.0f;
}

f32 mMsg_Get_CursolSetTimeCode(MessageWindow* window, s32 idx) {
    return mMsg_Get_CursolSetTimeCode_forData(window->messageData->dataBuffer, idx);
}

s32 mMsg_Get_ColorCode_forData(char* data, s32 idx, char* r, char* g, char* b) {
    char code = data[idx];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        code = data[idx + 1];

        if (code == 5) {
            *r = data[idx + 2];
            *g = data[idx + 3];
            *b = data[idx + 4];
            return TRUE;
        }
    }

    return FALSE;
}

s32 mMsg_Get_ColorCode(MessageWindow* window, s32 idx, char* r, char* g, char* b) {
    return mMsg_Get_ColorCode_forData(window->messageData->dataBuffer, idx, r, g, b);
}

s32 mMsg_Get_OrderCode_forData(char* data, s32 idx, s32* orderIdx, u16* orderValue) {
    char code = data[idx];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        code = data[idx + 1];

        if (code == 8 || code == 9 || code == 10 || code == 11 || code == 12) {
            u16 val;

            *orderIdx = data[idx + 2];
            val = (u16)(data[idx + 3]) << 8;
            *orderValue = val | ((data[idx + 4]) & 0xFF);
            return TRUE;
        }
    }

    return FALSE;
}

s32 mMsg_Get_OrderCode(MessageWindow* window, s32 idx, s32* orderIdx, u16* orderVal) {
    return mMsg_Get_OrderCode_forData(window->messageData->dataBuffer, idx, orderIdx, orderVal);
}

s32 mMsg_Get_SoundCutCode_forData(char* data, s32 idx) {
    if (data[idx] == MESSAGE_CHAR_CONTROL_CODE && data[idx + 1] == 81) {
        return data[idx + 2];
    }

    return FALSE;
}
s32 mMsg_Get_SoundCutCode(MessageWindow* window, s32 idx) {
    return mMsg_Get_SoundCutCode_forData(window->messageData->dataBuffer, idx);
}

void mMsg_Get_bgm_make_forData(char* data, s32 idx, s32* bgmType, s32* stopType) {
    char* code = &data[idx];

    if (code[0] == MESSAGE_CHAR_CONTROL_CODE && code[1] == 86 && code[2] < 8 && code[3] < 3) {
        *bgmType = code[2];
        *stopType = code[3];
    } else {
        *bgmType = 8;
        *stopType = 3;
    }
}

void mMsg_Get_bgm_make(MessageWindow* window, s32 idx, s32* bgmType, s32* stopTypee) {
    mMsg_Get_bgm_make_forData(window->messageData->dataBuffer, idx, bgmType, stopTypee);
}

