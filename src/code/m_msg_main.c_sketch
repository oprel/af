    s32 commandLen = mFont_CodeSize_idx_get(data, startIdx);
    char* landName = mLd_GetLandName();
    s32 landNameLen = mMsg_Get_Length_String(landName, LAND_NAME_SIZE);
    char muraStr[MESSAGE_FREE_STR_LEN];
    char* muraStrPtr;
    s32 muraSize;

    newStartIdx = startIdx + landNameLen;
    newLen = mMsg_MoveDataCut(data, startIdx + landNameLen, startIdx + commandLen, len, FALSE);

    mMsg_CopyString(&data[startIdx], landName, landNameLen);

    muraStrPtr = muraStr;
    mString_Load_StringFromRom(muraStrPtr, sizeof(muraStr), 0x1E4);

    muraSize = mMsg_Get_Length_String(muraStrPtr, sizeof(muraStr));
    newLen = mMsg_MoveDataCut(data, newStartIdx + muraSize, newStartIdx, newLen, FALSE);

    mMsg_CopyString(&data[newStartIdx], muraStrPtr, muraSize);

    return newLen;
}

