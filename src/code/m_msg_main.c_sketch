}

s32 mMsg_sound_voice_get2(s32 code) {
    if (code == MESSAGE_CHAR_NEW_LINE) {
        return 0x53;
    }

    return mMsg_sound_voice_get(code);
}

int mMsg_check_sound_special(MessageWindow* window) {
    s32 msgNo = window->messageData->msgNo;

    return (msgNo >= 0x1743 && msgNo <= 0x1756) || (msgNo >= 0x1799 && msgNo <= 0x17AC);
}

int mMsg_check_sound_animal(MessageWindow* window) {

    return window->showActorName || mMsg_check_sound_special(window);
}

s32 mMsg_sound_npc_id_get(MessageWindow* window) {
    s32 id = 0;
    Npc* npc = (Npc*)window->clientActor;

    if (npc != NULL && npc->actor.part == ACTOR_PART_NPC) {
        id = npc->npcSoundId;
    }

    return id;
}

void mMsg_sound_voice_entry(MessageWindow* window, s32 voiceSfxIdx, u8 voiceIdx, s16 animalVoiceIdx) {
    window->voiceSfxIdx = voiceSfxIdx;
    window->voiceIdx = voiceIdx;
    window->animalVoiceIdx = animalVoiceIdx;
    window->statusFlags |= 0x20;
}

void mMsg_sound_voice_endcode_set(MessageWindow* window) {
    s32 id = mMsg_sound_npc_id_get(window);

    sAdo_VoiceSe(0x53, id, 32);
    window->statusFlags &= ~0x20;
}

int mMsg_sound_CodeVoice(MessageWindow* window, s32 idx) {
    s32 npcId;
    char* data = window->messageData->dataBuffer;
    s32 voiceId = mMsg_sound_voice_get2(data[idx]);

    if (voiceId < 0) {
        return FALSE;
    } else if ((window->statusFlags & 1) != 0) {
        s32 voiceMode = common_data.save.config.voiceMode;

        if (voiceMode != 2) {
            sAdo_SysTrgStart(0x54);
        }

        mMsg_sound_voice_endcode_set(window);
        return FALSE;
    }
    if (voiceId == 0x54) {
        npcId = 0;
    } else {
        npcId = mMsg_sound_npc_id_get(window);
    }

    mMsg_sound_voice_entry(window, idx, voiceId, npcId);
    return voiceId != 0x55 && voiceId != 0x50 && voiceId != 0x4E && voiceId != 0x4F && voiceId != 0x52 &&
           voiceId != 0x54;
}

void mMsg_sound_PAGE_OKURI() {
    sAdo_SysTrgStart(0xB);
}

void mMsg_sound_ZOOMUP() {
    sAdo_SysTrgStart(0x4);
}

void mMsg_sound_ZOOMDOWN_SHORT() {
    sAdo_SysTrgStart(0x5);
}

void mMsg_sound_ZOOMDOWN_LONG() {
    sAdo_SysTrgStart(0x15);
}

u8 Sound_Now_MessageSpeed = 1;

void mMsg_sound_MessageSpeedForce(f32 timer) {
    u8 sTimer = (s32)timer;

    sTimer++;

    if (sTimer > 0) {
        if (sAdo_MessageSpeedGet() != sTimer) {
            sAdo_MessageSpeed(sTimer);
        }

        Sound_Now_MessageSpeed = sTimer;
    } else {
        sAdo_MessageSpeed(1);
        Sound_Now_MessageSpeed = 1;
    }
}

void mMsg_sound_MessageSpeedClear() {
    if (Sound_Now_MessageSpeed != 1) {
        Sound_Now_MessageSpeed = 1;
    } else if (sAdo_MessageSpeedGet() != 1) {
        sAdo_MessageSpeed(1);
    }
}

void mMsg_sound_MessageStatus(u8 status) {
    sAdo_MessageStatus(status);
}

u8 mMsg_bgm_num[] = { 255, 47, 48, 49, 50, 66, 255, 78, 122 };

u16 mMsg_bgm_stop[] = { 0x168, 0, 0x321C };

void mMsg_sound_bgm_make(s32 bgmNum, s32 stopType) {
    if (bgmNum == 0) {
        mBGMPsComp_make_ps_quiet(mMsg_bgm_stop[stopType]);
    } else if (bgmNum == 6) {
        mBGMPsComp_make_ps_fc_quietField(mMsg_bgm_stop[stopType]);
    } else {
        mBGMPsComp_make_ps_demo(mMsg_bgm_num[bgmNum], mMsg_bgm_stop[stopType]);
    }
}

void mMsg_sound_bgm_delete(s32 bgmNum, s32 stopType) {
    if (bgmNum == 0) {
        mBGMPsComp_delete_ps_quiet();
    } else {
        mBGMPsComp_delete_ps_demo(mMsg_bgm_num[bgmNum], mMsg_bgm_stop[stopType]);
    }
}

void mMsg_sound_sound_trg_sys(s32 seNum) {
    static u16 mMsg_se_num[] = { 0x1050, 0x012E, 0x012F, 0x0130, 0x0131, 0x0427, 0x0428 };

    sAdo_SysTrgStart(mMsg_se_num[seNum]);
}

u8 mMsg_sound_voice_mode_get(MessageWindow* window) {
    s32 voiceMode = common_data.save.config.voiceMode;
    u8 mode;

    if (mMsg_check_sound_animal(window)) {
        static u8 mode_table[] = { 0, 1, 2 };

        mode = mode_table[voiceMode];
    } else if (voiceMode == 2) {
        mode = 2;
    } else {
        mode = 1;
    }

    return mode;
}

void mMsg_sound_voice_mode(MessageWindow* window) {
    sAdo_SetVoiceMode(mMsg_sound_voice_mode_get(window));
}

void mMsg_sound_spec_change_voice_force(MessageWindow* window) {
    s32 spec;

    if (mMsg_check_sound_special(window)) {
        spec = 4;
    } else {
        spec = mNpc_GetNpcSoundSpec(window->clientActor);
    }

    sAdo_SpecChange(spec);
    window->statusFlags |= 0x10;
    window->spec = spec;
}

s32 mMsg_sound_spec_change_voice(MessageWindow* window) {
    if (mMsg_sound_voice_mode_get(window) == 0) {
        mMsg_sound_spec_change_voice_force(window);
        return TRUE;
    }

    return FALSE;
}

void mMsg_sound_spec_change_scene(MessageWindow* window) {
    if ((window->statusFlags & 0x10) != 0) {
        window->statusFlags &= ~0x10;
    }
}

void mMsg_sound_spec_change_true(MessageWindow* window) {
    Actor* actor = window->clientActor;

    if (actor != NULL && actor->part == ACTOR_PART_NPC) {
        u16 name = actor->fgName;

        if (name == 0xD026 || name == 0xD037) {
            sAdo_SpecChange(window->spec);
        }
    }
}

void mMsg_sound_spec_change_false(MessageWindow* window) {
    Actor* actor = window->clientActor;

    if (actor != NULL && actor->part == ACTOR_PART_NPC) {
        u16 name = actor->fgName;

        if (name == 0xD026 || name == 0xD037) {
            sAdo_SpecChange(7);
        }
    }
}

void mMsg_Main_Hide(MessageWindow* window, Game_Play* play) {
    mMsg_MainSetup_Window(window, play);
}

void mMsg_MainSetup_Hide(MessageWindow* window, Game_Play* play) {
    mMsg_init(play);
}

s32 mMsg_Main_Appear_SetScale(MessageWindow* window, Game_Play* play) {
    if (window->timer < 9.0f) {
        f32 scale;

        window->timer += 1.0f;
        scale = get_percent_forAccelBrake(window->timer, 0.0f, 9.0f, 0.0f, 0.0f);
        window->windowScale = scale;
        window->textScale = scale;
        return FALSE;
    } else {
        window->windowScale = 1.0f;
        window->textScale = 1.0f;
        window->timer = 0.0f;
        return TRUE;
    }
}

void mMsg_request_main_index_fromAppear(MessageWindow* window, Game_Play* play, s32 scaleDownFlag) {
    if (scaleDownFlag && mMsg_request_main_cursol(window, FALSE, 5)) {
        mMsg_SetTimer(window, 10.0f);
    }
}

void mMsg_Main_Appear(MessageWindow* window, Game_Play* play) {
    s32 scaleDownFlag = mMsg_Main_Appear_SetScale(window, play);

    mMsg_request_main_index_fromAppear(window, play, scaleDownFlag);
    mMsg_MainSetup_Window(window, play);
}

void mMsg_MainSetup_Appear(MessageWindow* window, Game_Play* play) {
    UNUSED s32 pad;
    MessageRequestAppearData* appearData;
    s32 msgNo;

    appearData = &window->requestData.appearData;
    msgNo = appearData->msgNo;

    if (mMsg_LoadMsgData(window->messageData, msgNo, FALSE)) {
        mMsg_Set_client_actor_p(window, appearData->speakerActor, appearData->nameShown);
        window->windowBackgroundColor = appearData->windowColor;
        mMsg_sound_spec_change_voice(window);
        mMsg_sound_voice_mode(window);
        window->mainIndex = MESSAGE_MAIN_INDEX_APPEAR;
        window->drawFlag = TRUE;
        window->windowScale = 0.0f;
        window->textScale = 0.0f;
        window->timer = 0.0f;
        window->showContinueButton = FALSE;
        window->requestedMainIndex = -1;
        window->requestedPriority = 4;
        window->startTextCursolIdx = 0;
        window->endTextCursolIdx = 0;

        if (window->clientActor != NULL) {
            switch (mNpc_GetNpcSex(window->clientActor)) {
                case NPC_SEX_MALE:
                    window->nameBackgroundColor.r = 70;
                    window->nameBackgroundColor.g = 245;
                    window->nameBackgroundColor.b = 255;
                    window->nameTextColor.r = 0;
                    window->nameTextColor.g = 0;
                    window->nameTextColor.b = 15;
                    break;

                case NPC_SEX_FEMALE:
                    window->nameBackgroundColor.r = 235;
                    window->nameBackgroundColor.g = 140;
                    window->nameBackgroundColor.b = 210;
                    window->nameTextColor.r = 45;
                    window->nameTextColor.g = 0;
                    window->nameTextColor.b = 30;
                    break;
                default:
                    window->nameBackgroundColor.r = 185;
                    window->nameBackgroundColor.g = 255;
                    //! FAKE
                    if (1)
                        ;
                    window->nameBackgroundColor.b = 0;
                    window->nameTextColor.r = 0;
                    window->nameTextColor.g = 30;
                    window->nameTextColor.b = 0;
                    break;
            }
        }
        window->dataLoaded = TRUE;

        { s32 scoped; }
    } else {
        window->dataLoaded = FALSE;
    }
}

int mMsg_Check_ScrollOrder(MessageWindow* window) {
    return (chkTrigger(A_BUTTON) || chkTrigger(B_BUTTON));
}

s32 mMsg_MsgTimeEnd_dec(MessageWindow* window) {
    if (window->endTimer == 0) {
        return FALSE;
    } else if (window->endTimer == 1) {
        return TRUE;
    } else {
        window->endTimer--;
        return FALSE;
    }
}

void mMsg_end_to_disappear(MessageWindow* window) {
    if (mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_DISAPPEAR, 5)) {
        mMsg_Clear_CursolIndex(window);
        mMsg_Unset_ForceNext(window);
    }
}

void mMsg_request_main_index_fromNormal(MessageWindow* window, Game_Play* play) {
    if (mMsg_MsgTimeEnd_dec(window) && mMsg_Check_NextIndex_MsgTimeEndCode(window)) {
        mMsg_end_to_disappear(window);
    } else if ((mMsg_Check_ScrollOrder(window) || window->forceNext) && window->lockContinue == FALSE) {
        s32 last = FALSE;

        if (mMsg_Check_NextIndex_ContinueCode(window) && window->continueCancelFlag == FALSE) {
            s32 continueMsg = window->continueMsgNo;

            if (continueMsg >= 0 && mMsg_ChangeMsgData(window, continueMsg)) {
                if (mMsg_request_main_cursol(window, FALSE, 5) && window->forceNext == FALSE &&
                    mMsg_Check_NextIndex_SetSelectWindowCode(window) == FALSE) {
                    if ((window->statusFlags & 2) == 0) {
                        mMsg_sound_PAGE_OKURI();
                    }
                }

                mMsg_Unset_ForceNext(window);
                mMsg_Set_continue_msg_num(window, -1);
            }
        } else if ((mMsg_Check_NextIndex_ContinueCode(window) && window->continueCancelFlag) ||
                   (last = mMsg_Check_NextIndex_LastCode(window)) || mMsg_Check_NextIndex_MsgTimeEndCode(window)) {
            if ((window->statusFlags & 0x80) == 0) {
                if (last && (window->statusFlags & 0x40)) {
                    window->statusFlags |= 0x80;
                } else {
                    mMsg_end_to_disappear(window);
                }
            }
        } else if (mMsg_request_main_cursol(window, FALSE, 5)) {
            if (window->forceNext == FALSE && mMsg_Check_NextIndex_SetSelectWindowCode(window) == FALSE &&
                (window->statusFlags & 2) == 0) {
                mMsg_sound_PAGE_OKURI();
            }

            mMsg_Unset_ForceNext(window);
        }
    }
}

// todo cn
void mMsg_Set_display_button_turn_color(MessageWindow* window, Game_Play* play) {

    f32* timer = &window->continueButtonTimer;

    *timer += 1.0f;
    if (*timer >= MESSAGE_BUTTON_TURN_TIME) {
        *timer = 0.0f;
    }
    {
        f32 target = (*timer - MESSAGE_BUTTON_TURN_TIME / 2) / (MESSAGE_BUTTON_TURN_TIME / 2);

        if (target <= 0.0f) {
            target = 1.0f + target;
        } else {
            target = 1.0f - target;
        }

        if (target < 0.0f) {
            target = 0.0f;
        } else if (target > 1.0f) {
            target = 1.0f;
        }

        window->continueButtonColor.a = (s32)(target * 255.0f);
    }
}

void mMsg_Main_Normal(MessageWindow* window, Game_Play* play) {
    mMsg_Set_display_button_turn_color(window, play);
    mMsg_request_main_index_fromNormal(window, play);
    mMsg_MainSetup_Window(window, play);

    if (window->mainIndex != MESSAGE_MAIN_INDEX_NORMAL) {
        window->statusFlags &= ~0x2;
    }
}

void mMsg_MainSetup_Normal(MessageWindow* window, Game_Play* play) {
    MessageRequestNormalData* normalData = &window->requestData.normalData;
    s32 waitFlag = normalData->waitFlag;

    window->mainIndex = MESSAGE_MAIN_INDEX_NORMAL;
    window->drawFlag = TRUE;
    window->requestedMainIndex = -1;
    window->requestedPriority = 4;
    window->statusFlags &= ~0x80;

    if (waitFlag != TRUE) {
        window->continueButtonTimer = 0.0f;
        window->continueButtonColor.a = 0;

        if (window->endTimer == 0) {
            window->showContinueButton = TRUE;
        } else {
            window->showContinueButton = FALSE;
        }

        window->cancelFlag = FALSE;
    }
}

s32 mMsg_Check_CancelOrder(MessageWindow* window) {
    if (window->cancelableFlag != FALSE && window->cancelFlag == FALSE) {
        if (chkTrigger(A_BUTTON) || chkTrigger(B_BUTTON)) {
            return TRUE;
        }
    }

    return FALSE;
}

s32 mMsg_Main_Cursol_Check_ControlCursol(MessageWindow* window, s32 idx) {
    char* data = window->messageData->dataBuffer;
    char code = data[idx];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        return TRUE;
    }

    return FALSE;
}

s32 mMsg_Main_Cursol_Last_ControlCursol(MessageWindow* window, s32* idxPtr) {
    window->endTextCursolIdx = *idxPtr;

    if ((window->statusFlags & 0x8)) {
        window->statusFlags &= ~0x8;
        return 1;
    } else {
        window->statusFlags |= 0x8;
        return 2;
    }
}

s32 mMsg_Main_Cursol_Continue_ControlCursol(MessageWindow* window, s32* idxPtr) {
    window->endTextCursolIdx = *idxPtr;

    if ((window->statusFlags & 0x8)) {
        window->statusFlags &= ~0x8;
        return 1;
    } else {
        window->statusFlags |= 0x8;
        return 2;
    }
}

s32 mMsg_Main_Cursol_Clear_ControlCursol(MessageWindow* window, s32* idxPtr) {
    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);
    window->endTextCursolIdx = *idxPtr;

    mMsg_Clear_CursolIndex(window);
    mMsg_SetTimer(window, 10.0f);

    return 2;
}

s32 mMsg_Main_Cursol_CursolSetTime_ControlCursol(MessageWindow* window, s32* idxPtr) {
    f32 setTime = mMsg_Get_CursolSetTimeCode(window, *idxPtr);

    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);
    window->endTextCursolIdx = *idxPtr;

    if (window->cancelFlag) {
        return 0;
    }

    if (setTime > 0.0f) {
        window->cursolTimer = setTime;

        if ((window->statusFlags & 0x100) != 0) {
            mMsg_sound_MessageSpeedForce(1.0f);
        } else {
            mMsg_sound_MessageSpeedForce(setTime);
        }

        return 2;
    }

    return 0;
}

s32 mMsg_Main_Cursol_Button_ControlCursol(MessageWindow* window, s32* idxPtr) {
    if ((window->statusFlags & 0x8)) {
        window->statusFlags &= ~0x8;
        (*idxPtr) += mMsg_Set_SizeCode(window, *idxPtr);
        window->endTextCursolIdx = *idxPtr;
        return 1;
    } else {
        window->statusFlags |= 0x8;
        window->endTextCursolIdx = *idxPtr;
        return 2;
    }
}

s32 mMsg_Main_Cursol_Color_ControlCursol(MessageWindow* window, s32* idxPtr) {
    s32 displayedLine = window->nowDisplayLine;
    Color_RGBA8* textColor;

    if (displayedLine >= 0 && displayedLine < MESSAGE_LINE_NUMBER) {
        textColor = &window->fontColor[displayedLine];
    } else {
        textColor = &window->fontColor[0];
    }

    mMsg_Get_ColorCode(window, *idxPtr, &textColor->r, &textColor->g, &textColor->b);
    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);

    return 0;
}

s32 mMsg_Main_Cursol_AbleCancel_ControlCursol(MessageWindow* window, s32* idxPtr) {
    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);
    window->cancelableFlag = TRUE;

    return 0;
}

s32 mMsg_Main_Cursol_UnableCancel_ControlCursol(MessageWindow* window, s32* idxPtr) {
    *idxPtr += mMsg_Set_SizeCode(window, *idxPtr);
    window->cancelFlag = FALSE;
    window->cancelableFlag = FALSE;

    return 0;
}

