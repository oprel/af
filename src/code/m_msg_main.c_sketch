typedef s32 (*MessageCursolProc)(MessageWindow* window, s32* idxPtr);

s32 mMsg_Main_Cursol_Proc_ControlCursol(MessageWindow* window, s32* idxPtr) {
    char* data = window->messageData->dataBuffer;
    char code = data[*idxPtr];

    if (code == MESSAGE_CHAR_CONTROL_CODE) {
        static MessageCursolProc proc[] = {
            NULL,
        };

        s32 type = data[*idxPtr + 1];

        if (type < 0 || type >= 0x61 || proc[type] == NULL) {
            return 0;
        } else {
            return proc[type](window, idxPtr);
        }
    } else {
        return 0;
    }
}

s32 mMsg_Main_Cursol_ControlCursol(MessageWindow* window) {
    s32 endTextCursol;
    s32 idx;
    f32* cursolTimer;
    s32 choiceHidden;
    s32 res;
    char code;

    endTextCursol = window->endTextCursolIdx;
    idx = endTextCursol;
    cursolTimer = &window->cursolTimer;
    choiceHidden = mChoice_check_main_index(&window->choiceWindow) == Choice_MAIN_INDEX_DISAPPEAR;
    res = TRUE;

    if (chkTrigger(B_BUTTON)) {
        window->statusFlags |= 0x100;
    }

    if (mMsg_Check_CancelOrder(window)) {
        window->cancelFlag = TRUE;
    }

    if (window->cancelFlag) {
        *cursolTimer = 0.0f;
    } else if ((window->statusFlags & 0x100)) {
        *cursolTimer = 0.0f;
    } else {
        (*cursolTimer) -= 1.0f;

        if (*cursolTimer <= 0.0f) {
            *cursolTimer = 0.0f;
        }
    }

    if (choiceHidden) {
        if (window->hideChoiceWindowTimer > 0) {
            window->hideChoiceWindowTimer--;
        }
    } else {
        window->hideChoiceWindowTimer = 3;
    }

    mMsg_Unset_NowUtter(window);

    if ((*cursolTimer <= 0.0f) && choiceHidden) {
        while (TRUE) {
            code = window->messageData->dataBuffer[idx];

            if (mMsg_Check_CancelOrder(window)) {
                window->cancelFlag = TRUE;
            } else if (code == MESSAGE_CHAR_NEW_LINE) {
                idx += mMsg_Set_SizeCode(window, idx);
                window->nowDisplayLine++;
            } else if (code == MESSAGE_CHAR_TAG_CODE) {
                idx += mMsg_Set_SizeCode(window, idx);
            } else if (mMsg_Main_Cursol_Check_ControlCursol(window, idx)) {
                s32 procRes = mMsg_Main_Cursol_Proc_ControlCursol(window, &idx);

                if (procRes == 1) {
                    if (window->hideChoiceWindowTimer == 0) {
                        mMsg_sound_voice_endcode_set(window);
                    }

                    res = FALSE;
                    break;
                } else if (procRes == 2) {
                    break;
                } else {
                }
            } else {
                s32 idxTmp = idx;

                idx += mMsg_Set_SizeCode(window, idxTmp);
                window->endTextCursolIdx = idx;
                mMsg_sound_MessageSpeedClear();

                if (window->cancelFlag == FALSE) {
                    if (mMsg_sound_CodeVoice(window, idxTmp)) {
                        mMsg_Set_NowUtter(window);
                    }
                    break;
                }
            }
        }
    }

    return res;
}

void mMsg_request_main_index_fromCursol(MessageWindow* window, s32 processing) {
    if (processing == FALSE) {
        mMsg_request_main_normal(window, FALSE, 5);
    }
}

void mMsg_Main_Cursol(MessageWindow* window, Game_Play* play) {
    s32 processing = mMsg_Main_Cursol_ControlCursol(window);

    mMsg_request_main_index_fromCursol(window, processing);
    mMsg_MainSetup_Window(window, play);

    if (window->mainIndex != MESSAGE_MAIN_INDEX_CURSOL) {
        window->statusFlags &= ~0x100;
    }
}

void mMsg_MainSetup_Cursol(MessageWindow* window, Game_Play* play) {
    MessageRequestCursolData* requestData = &window->requestData.cursolData;
    s32 waitFlag = requestData->waitFlag;

    window->mainIndex = MESSAGE_MAIN_INDEX_CURSOL;
    window->drawFlag = TRUE;
    window->requestedMainIndex = -1;
    window->requestedPriority = 4;
    window->endTimer = 0;
    window->statusFlags &= ~0x8;

    if (waitFlag != TRUE) {
        window->showContinueButton = FALSE;
    }

    window->hideChoiceWindowTimer = 0;
}

s32 mMsg_Main_Disappear_SetScale(MessageWindow* window, Game_Play* play) {
    if (window->timer < 9.0f) {
        f32 scale;

        window->timer += 1.0f;
        scale = 1.0f - get_percent_forAccelBrake(window->timer, 0.0f, 9.0f, 0.0f, 0.0f);
        window->windowScale = scale;
        window->textScale = scale;
        return FALSE;
    } else {
        window->windowScale = 0.0f;
        window->textScale = 0.0f;
        window->timer = 0.0f;
        return TRUE;
    }
}

void mMsg_request_main_index_fromDisappear(MessageWindow* window, s32 scaleDownFlag) {
    if (scaleDownFlag) {
        mMsg_Change_request_main_index(window, MESSAGE_MAIN_INDEX_HIDE, 5);
    }
}

void mMsg_Main_Disappear(MessageWindow* window, Game_Play* play) {
    s32 scaleDownFlag = mMsg_Main_Appear_SetScale(window, play);

    mMsg_request_main_index_fromDisappear(window, scaleDownFlag);
    mMsg_MainSetup_Window(window, play);
}

void mMsg_MainSetup_Disappear(MessageWindow* window, Game_Play* play) {
    mMsg_sound_spec_change_scene(window);
    window->mainIndex = MESSAGE_MAIN_INDEX_DISAPPEAR;
    window->drawFlag = TRUE;
    window->windowScale = 1.0f;
    window->textScale = 1.0f;
    window->timer = 0.0f;
    window->showContinueButton = FALSE;

    if (mDemo_Get_use_zoom_sound()) {
        if (mDemo_Get_camera() == FALSE) {
            mMsg_sound_ZOOMDOWN_SHORT();
        } else {
            mMsg_sound_ZOOMDOWN_LONG();
        }
    }

    window->requestedMainIndex = -1;
    window->requestedPriority = 4;
}

void mMsg_request_main_index_fromAppear_wait(MessageWindow* window, Game_Play* play, s32 scalingDoneFlag) {
    if (scalingDoneFlag) {
        MessageMainWaitAppearData* appearWaitData = &window->mainData.appearWaitData;
        s32 lastMainIndex = appearWaitData->lastMainIndex;

        if (lastMainIndex == MESSAGE_MAIN_INDEX_CURSOL) {
            if (mMsg_request_main_cursol(window, TRUE, 5)) {}
        } else {
            mMsg_request_main_normal(window, TRUE, 5);
        }
    }
}

void mMsg_Main_Appear_wait(MessageWindow* window, Game_Play* play) {
    s32 scalingFinished;

    if ((window->statusFlags & 0x4) == FALSE) {
        window->statusFlags |= 0x4;
        mMsg_sound_ZOOMUP();
        mMsg_sound_spec_change_voice(window);
        mMsg_sound_voice_mode(window);
    }

    scalingFinished = mMsg_Main_Appear_SetScale(window, play);
    mMsg_request_main_index_fromAppear_wait(window, play, scalingFinished);
    mMsg_MainSetup_Window(window, play);
}

void mMsg_MainSetup_Appear_Wait(MessageWindow* window, Game_Play* play) {
    MessageRequestAppearWaitData* reqAppearWaitData = &window->requestData.appearWaitData;
    MessageMainWaitAppearData* appearWaitData = &window->mainData.appearWaitData;

    if ((reqAppearWaitData->setupFlag & 1)) {
        mMsg_Clear_CursolIndex(window);
    }

    appearWaitData->lastMainIndex = reqAppearWaitData->lastMainIndex;
    window->mainIndex = MESSAGE_MAIN_INDEX_APPEAR_WAIT;
    window->drawFlag = TRUE;
    window->windowScale = 0.0f;
    window->textScale = 0.0f;
    window->timer = 0.0f;
    window->statusFlags &= ~0x4;
    window->requestedMainIndex = -1;
    window->requestedPriority = 4;
}

void mMsg_Main_Wait(MessageWindow* window, Game_Play* play) {
    mMsg_MainSetup_Window(window, play);
}

void mMsg_MainSetup_Wait(MessageWindow* window, Game_Play* play) {
    MessageRequestWaitData* reqWaitData = &window->requestData.waitData;
    MessageMainWaitData* waitData = &window->mainData.waitData;

    waitData->lastMainIndex = reqWaitData->lastMainIndex;
    window->mainIndex = MESSAGE_MAIN_INDEX_WAIT;
    window->drawFlag = FALSE;
    window->windowScale = 0.0f;
    window->textScale = 0.0f;
    window->timer = 0.0f;
    window->requestedMainIndex = -1;
    window->requestedPriority = 4;
}

void mMsg_request_main_index_fromDisappear_wait(MessageWindow* window, s32 scalingDoneFlag) {
    if (scalingDoneFlag) {
        MessageMainWaitDisappearData* disappearWaitData = &window->mainData.disappearWaitData;
        s32 lastMainIndex = disappearWaitData->lastMainIndex;

        mMsg_request_main_wait(window, lastMainIndex, 5);
    }
}

void mMsg_Main_Disappear_wait(MessageWindow* window, Game_Play* play) {
    s32 scalingFinished;

    scalingFinished = mMsg_Main_Disappear_SetScale(window, play);
    mMsg_request_main_index_fromDisappear_wait(window, scalingFinished);
    mMsg_MainSetup_Window(window, play);
}

void mMsg_MainSetup_Disappear_wait(MessageWindow* window, Game_Play* play) {
    MessageRequestDisappearWaitData* reqDisappearWaitData = &window->requestData.disappearWaitData;
    MessageMainWaitDisappearData* appearWaitData = &window->mainData.disappearWaitData;

    appearWaitData->lastMainIndex = reqDisappearWaitData->lastMainIndex;
    window->mainIndex = MESSAGE_MAIN_INDEX_DISAPPEAR_WAIT;
    window->drawFlag = TRUE;
    window->windowScale = 1.0f;
    window->textScale = 1.0f;
    window->timer = 0.0f;
    mMsg_sound_ZOOMDOWN_SHORT();
    window->requestedMainIndex = -1;
    window->requestedPriority = 4;
}

void mMsg_SetMatrix(MessageWindow* window, Game_Play* play, s32 mode) {
    GraphicsContext* graph = play->state.gfxCtx;
    f32 scale = window->windowScale;
    f32 centerX = (window->centerX - ((f32)SCREEN_WIDTH * 0.5f)) * 16.0f;
    f32 centerY = (-window->centerY + ((f32)SCREEN_HEIGHT * 0.5f)) * 16.0f;

    Matrix_push();
    Matrix_translate(centerX, centerY, 0.0f, 1);
    Matrix_scale(scale, scale, scale, 1);

    OPEN_DISPS(graph);

    if (mode == 1) {
        gSPMatrix(FONT_DISP++, _Matrix_to_Mtx_new(graph), G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH);
    } else {
        gSPMatrix(POLY_OPA_DISP++, _Matrix_to_Mtx_new(graph), G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH);
    }

    CLOSE_DISPS(graph);
}

void mMsg_UnSetMatrix() {
    Matrix_pull();
}

void mMsg_DrawNameWindow(MessageWindow* window, Game_Play* play, s32 mode) {
    GraphicsContext* graph = play->state.gfxCtx;

    OPEN_DISPS(graph);

    if (mode == 1) {
        gDPSetPrimColor(FONT_DISP++, 0, 255, window->nameBackgroundColor.r, window->nameBackgroundColor.g,
                        window->nameBackgroundColor.b, 255);
        gSPDisplayList(FONT_DISP++, con_kaiwaname_modelT);
    } else {
        gDPSetPrimColor(POLY_OPA_DISP++, 0, 255, window->nameBackgroundColor.r, window->nameBackgroundColor.g,
                        window->nameBackgroundColor.b, 255);
        gSPDisplayList(POLY_OPA_DISP++, con_kaiwaname_modelT);
    }

    CLOSE_DISPS(graph);
}

void mMsg_DrawWindowClientName(MessageWindow* window, Game_Play* play, s32 mode) {
    char name[ANIMAL_NAME_LEN];

    mNpc_GetNpcWorldName(name, (Npc*)window->clientActor);
#ifndef AF_CN
    mFont_SetLineStrings_AndSpace(&play->state, name, window->clientNameLen, window->nameplateX, window->nameplateY,
                                  window->nameTextColor.r, window->nameTextColor.g, window->nameTextColor.b,
                                  window->nameTextColor.a, FALSE, FALSE, TRUE, 1.0f, 1.0f, mode);
#else
    if (window->textScale == 1.0f) {
        mFont_SetLineStrings_AndSpace(&play->state, name, window->clientNameLen, window->nameplateX,
                                      window->nameplateY + 68.0f, window->nameTextColor.r, window->nameTextColor.g,
                                      window->nameTextColor.b, window->nameTextColor.a);
    }
#endif
}

void mMsg_DrawWindowTurnButton(MessageWindow* window, Game_Play* play, s32 mode) {
    if (window->showContinueButton != FALSE && window->lockContinue == FALSE) {
        mFont_SetMarkChar(&play->state, 3, 257.0f, 136.0f, window->continueButtonColor.r, window->continueButtonColor.g,
                          window->continueButtonColor.b, window->continueButtonColor.a, FALSE, 1.0f, 1.0f, mode);
    }
}
;

void mMsg_DrawWindowBody(MessageWindow* window, Game_Play* play, s32 mode) {
    GraphicsContext* graph = play->state.gfxCtx;
    Color_RGBA8* windowBackgroundColor = &window->windowBackgroundColor;
    OPEN_DISPS(graph);

    if (mode == 1) {
        gSPDisplayList(FONT_DISP++, mMsg_init_disp);
        gDPSetPrimColor(FONT_DISP++, 0, 255, windowBackgroundColor->r, windowBackgroundColor->g,
                        windowBackgroundColor->b, windowBackgroundColor->a);
        gSPDisplayList(FONT_DISP++, con_kaiwa2_modelT);

        if (window->showActorName) {
            mMsg_DrawNameWindow(window, play, mode);
            mMsg_DrawWindowClientName(window, play, mode);
        }

        mMsg_DrawWindowTurnButton(window, play, mode);
    } else {
        gSPDisplayList(POLY_OPA_DISP++, mMsg_init_disp);
        gDPSetPrimColor(POLY_OPA_DISP++, 0, 255, windowBackgroundColor->r, windowBackgroundColor->g,
                        windowBackgroundColor->b, windowBackgroundColor->a);
        gSPDisplayList(POLY_OPA_DISP++, con_kaiwa2_modelT);

        if (window->showActorName) {
            mMsg_DrawNameWindow(window, play, mode);
            mMsg_DrawWindowClientName(window, play, mode);
        }

        mMsg_DrawWindowTurnButton(window, play, mode);
    }
    CLOSE_DISPS(graph);
}

void mMsg_draw_font(MessageWindow* window, Game_Play* play) {
    FontSentence sentence;
    char* lastPtr = &window->messageData->dataBuffer[window->endTextCursolIdx];
    char* startPtr = &window->messageData->dataBuffer[window->startTextCursolIdx];
    s32 lineNum;
    char* curPtr;
    char code;
    char contType;
    s32 len;
    s32 lineLen;
    s32 totalLen;
    xy_t scale;
    xy_t pos;
    Gfx* __font_gfx;
    s32 lineEndFlag;
    u32 sentenceFlags;
    s32 sentenceFinishedFlag;

    s32 senteceVoiceIdx = window->voiceSfxIdx - window->startTextCursolIdx;

    if (fabsf(window->textScale) < 0.001f) {
        return;
    }

    OPEN_DISPS(play->state.gfxCtx);
    __font_gfx = FONT_DISP;

    sentenceFinishedFlag = FALSE;

    scale.x = window->textScale;
    scale.y = window->textScale;

    pos.x = window->centerX - (96.0f * scale.x);
#ifndef AF_CN
    pos.y = window->centerY - (32.0f * scale.y);
#else
    pos.y = window->centerY - (24.0f * scale.y);
#endif
    lineNum = 0;
    totalLen = 0;

    while (lineNum < window->textLines && sentenceFinishedFlag == FALSE) {
        for (lineLen = 0, curPtr = startPtr, lineEndFlag = FALSE; curPtr < lastPtr && lineEndFlag == FALSE;
             len = mFont_CodeSize_get(curPtr), curPtr += len, lineLen += len) {
            code = curPtr[0];

            if (code == MESSAGE_CHAR_NEW_LINE) {
                lineEndFlag = TRUE;
            } else if (code == MESSAGE_CHAR_CONTROL_CODE) {
                contType = curPtr[1];
                if (contType == 0 || contType == 1 || contType == 0x58) {
                    lineEndFlag = TRUE;
                    sentenceFinishedFlag = TRUE;
                }
            }
        }

        if (curPtr >= lastPtr) {
            sentenceFinishedFlag = TRUE;
        }

        if (lineNum == 0) {
            sentenceFlags = 0x40;
        } else {
            sentenceFlags = 0x58;
        }

        if (window->statusFlags & 0x20 && senteceVoiceIdx >= totalLen && senteceVoiceIdx < (totalLen + lineLen)) {
            sentenceFlags |= 0x80;
        }

        mFontSentence_set(&sentence, startPtr, lineLen, sentenceFlags, &pos, 0, &scale, &window->fontColor[lineNum],
                          senteceVoiceIdx - totalLen, window->voiceIdx, window->animalVoiceIdx);

        mFontSentence_gppDraw(&sentence, play, &__font_gfx);

#ifndef AF_CN

        pos.y += 16.0f * scale.y;
#else
        pos.y += 12.0f * scale.y;

#endif
        startPtr = curPtr;
        lineNum++;
        totalLen += lineLen;
    }

    FONT_DISP = __font_gfx;
    CLOSE_DISPS(play->state.gfxCtx);
    window->statusFlags &= ~0x20;
}

typedef void (*MessageMainProc)(MessageWindow* window, Game_Play* play);

void mMsg_MainSetup_Window(MessageWindow* window, Game_Play* play) {
    static MessageMainProc proc[] = {
        &mMsg_MainSetup_Hide,      &mMsg_MainSetup_Appear,      &mMsg_MainSetup_Normal, &mMsg_MainSetup_Cursol,
        &mMsg_MainSetup_Disappear, &mMsg_MainSetup_Appear_Wait, &mMsg_MainSetup_Wait,   &mMsg_MainSetup_Disappear_wait,
    };

    s32 idx = window->requestedMainIndex;

    if (idx >= 0) {
        if (idx >= MESSAGE_MAIN_INDEX_MAX || proc[idx] == NULL) {
            return;
        }

        proc[idx](window, play);
    }
}

void mMsg_Main_Window(MessageWindow* window, Game_Play* play) {
    static MessageMainProc proc[] = {
        &mMsg_Main_Hide,      &mMsg_Main_Appear,      &mMsg_Main_Normal, &mMsg_Main_Cursol,
        &mMsg_Main_Disappear, &mMsg_Main_Appear_wait, &mMsg_Main_Wait,   &mMsg_Main_Disappear_wait,
    };

#ifndef AF_CN
    s32 idx;
#else
    u32 idx;
#endif

    idx = window->mainIndex;

    if (idx >= 0) {
        if (idx >= MESSAGE_MAIN_INDEX_MAX || proc[idx] == NULL) {
            return;
        }

        proc[idx](window, play);
    }
}

void mMsg_Draw_Window(MessageWindow* window, Game_Play* play) {
    if (window->drawFlag && window->dataLoaded) {
        mFont_SetMatrix(play->state.gfxCtx, 1);
        mMsg_SetMatrix(window, play, 1);
        mMsg_DrawWindowBody(window, play, 1);
        mMsg_UnSetMatrix();
        mFont_UnSetMatrix(play->state.gfxCtx, 1);

        if (window->messageData->dataLoaded) {
            mMsg_draw_font(window, play);
        }

        mChoice_Draw(&window->choiceWindow, play, 1);
    }
}

void mMsg_ct(Game_Play* play) {
    mMsg_init(play);
    mChoice_ct(&mMsg_window.choiceWindow, play);
}

void mMsg_dt(Game_Play* play) {
    mChoice_dt(&mMsg_window.choiceWindow, play);
}

void mMsg_debug_draw(gfxprint* gfxprint) {
    if (mMsg_window.messageData != NULL) {
        gfxprint_color(gfxprint, 245, 255, 250, 255);
        gfxprint_locate8x8(gfxprint, 3, 6);
        gfxprint_printf(gfxprint, "%5d", mMsg_window.messageData->msgNo);
    }
}

void mMsg_Main(Game_Play* play) {
    mMsg_Main_Window(&mMsg_window, play);
    mChoice_Main(&mMsg_window.choiceWindow, play);
}
void mMsg_Draw(Game_Play* play) {
    mMsg_Draw_Window(&mMsg_window.choiceWindow, play);
}

