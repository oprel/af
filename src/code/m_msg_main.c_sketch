s32 mMsg_CopyFree(MessageWindow* window, s32 strNo, char* data, s32 startIdx, s32 len) {
    s32 commandLen;
    char* freeStr;
    s32 freeStrLen;
    s32 newLen;

    if (strNo < MESSAGE_FREE_STR0 || strNo >= MESSAGE_FREE_STR_MAX) {
        strNo = MESSAGE_FREE_STR0;
    }

    commandLen = mFont_CodeSize_idx_get(data, startIdx);
    freeStr = window->freeStr[strNo];
    freeStrLen = mMsg_Get_Length_String(freeStr, MESSAGE_FREE_STR_LEN);
    newLen = mMsg_MoveDataCut(data, startIdx + freeStrLen, startIdx + commandLen, len, FALSE);

    mMsg_CopyString(&data[startIdx], freeStr, freeStrLen);

    return newLen;
}

Color_RGB8 MMSG_pf_cl[6] = { { 0, 0, 0 },     { 145, 60, 145 }, { 50, 130, 70 },
                             { 75, 95, 155 }, { 160, 50, 75 },  { 50, 75, 225 } };

s32 mMsg_Set_PfColor(char* data, s32* startIdx, s32 len, char* freeStr, s32 fcColorId) {
    static u8 add_string[] = { MESSAGE_CHAR_CONTROL_CODE, 0x50, 0, 0, 0, 0 };
#ifndef AF_CN
    s32 freeStrLen = mMsg_Get_Length_String(freeStr, MESSAGE_FREE_STR_LEN);
#else
    s32 freeStrLen = func_800A5490(freeStr, MESSAGE_FREE_STR_LEN, 32);
#endif
    s32 newLen;
    s32 srcIdx = *startIdx;
    Color_RGB8* colorData = &MMSG_pf_cl[fcColorId];

    add_string[2] = colorData->r;
    add_string[3] = colorData->g;
    add_string[4] = colorData->b;

    add_string[5] = freeStrLen;

    newLen = mMsg_MoveDataCut(data, srcIdx + sizeof(add_string), srcIdx, len, FALSE);
    mMsg_CopyString(data + srcIdx, add_string, sizeof(add_string));

    *startIdx += sizeof(add_string);

    return newLen;
}

