s32 mMsg_Main_Cursol_MsgTimeEnd_ControlCursol(MessageWindow* window, s32* idxPtr) {
    window->endTextCursolIdx = *idxPtr;

    if ((window->statusFlags & 0x8)) {
        s32 time = mMsg_Get_MsgTimeEnd_time(window, *idxPtr);

        if (time > 0) {
            time--;
        }

        window->endTimer = (time << 1) + 1;
        window->statusFlags &= ~0x8;
        return 1;
    } else {
        window->statusFlags |= 0x8;
        return 2;
    }
}

